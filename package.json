  ],
  "homepage": "https://github.com/pixma140/gymapp",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixma140/gymapp.git"
  },
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "SEED_DEV_DATA=${SEED_DEV_DATA:-true} PORT=${PORT:-3000} DATA_DIR=${DATA_DIR:-./db} node server/index.js",
    "db:reset": "DATA_DIR=${DATA_DIR:-./db} node server/reset.js",
    "db:reset:seed": "DATA_DIR=${DATA_DIR:-./db} node server/reset.js --seed",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  }
}
