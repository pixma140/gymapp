# Copy to .env. API and reset commands load .env; exported variables take precedence.
# NODE_ENV defaults to development for the API; Compose sets production.
# Do not set NODE_ENV=development here: Vite also reads this file during builds.
PORT=3000
DATA_DIR=./db
VITE_API_TARGET=http://localhost:3000
PUBLIC_URL=
COOKIE_SECURE=false

# Enable only after setting both account credentials. No built-in credentials.
SEED_DEV_DATA=false
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=

# Optional startup promotion for non-fixture installations.
ADMIN_USERNAME=

# Blank non-secret OIDC fields remain editable in the admin UI.
# Set true/false explicitly to lock the enabled field to the environment.
OIDC_ENABLED=
OIDC_ISSUER=
OIDC_SCOPES=
# Credentials are environment-only and never returned by configuration APIs.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
